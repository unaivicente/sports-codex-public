{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.contracts/ontology.schema.json",
  "title": "OntologyContract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ontology_id",
    "ontology_version",
    "labels"
  ],
  "properties": {
    "ontology_id": {
      "type": "string",
      "minLength": 1
    },
    "ontology_version": {
      "type": "string",
      "minLength": 1
    },
    "previous_ontology_version": {
      "type": "string",
      "minLength": 1,
      "description": "Previous ontology_version when this payload was produced by an evolution workflow."
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "label_id",
          "label_type",
          "display_name"
        ],
        "properties": {
          "label_id": {
            "type": "string",
            "minLength": 1
          },
          "label_type": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mutually_exclusive_with": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "metadata": {
            "type": "object"
          },
          "deprecated": {
            "type": "boolean"
          },
          "replacement_label_id": {
            "type": "string",
            "minLength": 1
          },
          "deprecated_in_version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "deprecated_labels": {
      "type": "array",
      "description": "Deprecated labels retained for interpretability and mapped to replacement labels.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "label_id",
          "replacement_label_id",
          "deprecated_in_version"
        ],
        "properties": {
          "label_id": {
            "type": "string",
            "minLength": 1
          },
          "replacement_label_id": {
            "type": "string",
            "minLength": 1
          },
          "deprecated_in_version": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          },
          "migration_note": {
            "type": "string"
          }
        }
      }
    },
    "evolution": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "change_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "previous_ontology_version": {
          "type": "string",
          "minLength": 1
        },
        "ontology_version": {
          "type": "string",
          "minLength": 1
        },
        "added_label_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deprecated_label_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "local_first": {
          "type": "boolean"
        }
      }
    },
    "transition_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "from_label",
          "to_label",
          "rule_type"
        ],
        "properties": {
          "from_label": {
            "type": "string",
            "minLength": 1
          },
          "to_label": {
            "type": "string",
            "minLength": 1
          },
          "rule_type": {
            "type": "string",
            "minLength": 1
          },
          "min_gap_seconds": {
            "type": "number",
            "minimum": 0
          },
          "max_gap_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
