{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.contracts/human_correction.schema.json",
  "title": "HumanCorrectionContract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "correction_id",
    "video_id",
    "target_interval",
    "corrected_intervals",
    "correction_type",
    "edit_operation",
    "source_predictions",
    "primary_source_prediction_id",
    "ontology_version",
    "evidence_snapshot",
    "learning_mode",
    "reviewer_id",
    "reviewer_role",
    "reviewer_confidence",
    "trust_weight",
    "review_status",
    "created_at"
  ],
  "properties": {
    "correction_id": {
      "type": "string",
      "minLength": 1
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "target_interval": {
      "$ref": "#/$defs/target_interval"
    },
    "corrected_intervals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/corrected_interval"
      }
    },
    "correction_type": {
      "enum": [
        "confirm",
        "modify",
        "delete",
        "add",
        "ontology_gap"
      ]
    },
    "edit_operation": {
      "enum": [
        "none",
        "split",
        "merge",
        "relabel",
        "boundary_adjust"
      ]
    },
    "source_predictions": {
      "type": "array",
      "items": {
        "$ref": "prediction.schema.json"
      }
    },
    "primary_source_prediction_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "ontology_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_snapshot": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "learning_mode": {
      "enum": [
        "training",
        "soft"
      ]
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_role": {
      "enum": [
        "internal",
        "external",
        "admin",
        "unknown"
      ]
    },
    "reviewer_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "trust_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_status": {
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "needs_review"
      ]
    },
    "post_correction_model_agreement": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "confidence_delta": {
      "type": [
        "number",
        "null"
      ]
    },
    "supersedes_correction_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "target_interval": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "interval_start",
        "interval_end",
        "timebase",
        "source_prediction_ids"
      ],
      "properties": {
        "interval_start": {
          "type": "number",
          "minimum": 0
        },
        "interval_end": {
          "type": "number",
          "minimum": 0
        },
        "timebase": {
          "type": "string",
          "minLength": 1
        },
        "source_prediction_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "corrected_interval": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "interval_start",
        "interval_end",
        "timebase",
        "label",
        "ontology_version",
        "reviewer_confidence",
        "evidence_refs"
      ],
      "properties": {
        "interval_start": {
          "type": "number",
          "minimum": 0
        },
        "interval_end": {
          "type": "number",
          "minimum": 0
        },
        "timebase": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ontology label identifier, or null only for ontology_gap corrections."
        },
        "ontology_version": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proposed_label": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
