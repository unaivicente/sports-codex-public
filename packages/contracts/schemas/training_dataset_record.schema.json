{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.contracts/training_dataset_record.schema.json",
  "title": "TrainingDatasetRecordContract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "training_example_id",
    "dataset_version",
    "correction_id",
    "video_id",
    "sport",
    "interval_start",
    "interval_end",
    "timebase",
    "label",
    "source",
    "correction_type",
    "edit_operation",
    "learning_mode",
    "trust_weight",
    "ontology_version",
    "source_prediction_ids",
    "source_model_versions",
    "source_ontology_versions",
    "evidence_snapshot",
    "split"
  ],
  "properties": {
    "training_example_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "correction_id": {
      "type": "string",
      "minLength": 1
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "sport": {
      "type": "string",
      "minLength": 1,
      "description": "Sport identifier derived from the ontology definition."
    },
    "interval_start": {
      "type": "number",
      "minimum": 0
    },
    "interval_end": {
      "type": "number",
      "minimum": 0
    },
    "timebase": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "Ontology label identifier."
    },
    "source": {
      "enum": [
        "confirmed",
        "corrected",
        "human_added"
      ]
    },
    "correction_type": {
      "enum": [
        "confirm",
        "modify",
        "add"
      ]
    },
    "edit_operation": {
      "enum": [
        "none",
        "split",
        "merge",
        "relabel",
        "boundary_adjust"
      ]
    },
    "learning_mode": {
      "enum": [
        "training",
        "soft"
      ]
    },
    "trust_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ontology_version": {
      "type": "string",
      "minLength": 1
    },
    "source_prediction_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_model_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_ontology_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_snapshot": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    }
  }
}
