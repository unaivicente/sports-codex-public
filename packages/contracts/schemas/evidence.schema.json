{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.contracts/evidence.schema.json",
  "title": "EvidenceContract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "evidence_id",
    "modality",
    "timestamp",
    "type",
    "value",
    "confidence",
    "source_model_version"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "modality": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "number",
      "minimum": 0
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_model_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
